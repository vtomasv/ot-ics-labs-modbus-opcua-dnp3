# Opcional: cp .env.example .env; nunca incluya .env real en Git.
# Panel local; no cambiar a 0.0.0.0 ni conectar este lab a una red OT real.
DASHBOARD_PORT=8080
LAB_TOKEN=ot-ics-local-demo-token
# auto intenta tcpdump y usa AF_PACKET si libpcap falla; python fuerza el modo AF_PACKET.
CAPTURE_BACKEND=auto
